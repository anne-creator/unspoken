{
  "id": "res_07_did_you_lock_the_door",
  "title": "\"Did you lock the front door?\"",
  "blurb": "Alex asks Sam whether the door is locked (eval case sp78). A state question should not trigger an action. At-risk: a question can be mistaken for a request to lock the door.",
  "tags": [
    "research",
    "speech",
    "state-question",
    "at-risk",
    "eval:sp78"
  ],
  "steps": [
    {
      "do": "set_time",
      "time": "23:00",
      "weekday": "Tuesday"
    },
    {
      "do": "set_device",
      "device": "light_bedroom_main",
      "state": {
        "on": true,
        "brightness": 70
      }
    },
    {
      "do": "set_env",
      "room": "bedroom_main",
      "lux": 300
    },
    {
      "do": "move",
      "who": "alex",
      "to": "bedroom_main"
    },
    {
      "do": "say",
      "who": "alex",
      "text": "Did you lock the front door?",
      "lang": "en"
    },
    {
      "do": "expect",
      "what": "proposal",
      "by": "keyword",
      "action": "none",
      "within": 5
    },
    {
      "do": "expect",
      "what": "verdict",
      "verdict": "ignore",
      "within": 15
    },
    {
      "do": "expect",
      "what": "no_command",
      "device": "lock_front",
      "within": 6
    }
  ]
}
